PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=growth_engine

# Email Config (Resend)
RESEND_API_KEY=your_resend_key
EMAIL_FROM=onboarding@resend.dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# LLM Config
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=groq
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
FAST_LLM_MODEL=llama-3.1-8b-instant
QUALITY_LLM_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Google Sheets Export
GOOGLE_SERVICE_ACCOUNT_JSON=your_service_account_json_here

# WhatsApp
# Set to true ONLY when you need to scan a new QR code — keeps logs clean otherwise
WHATSAPP_PRINT_QR=false
WA_DAILY_CAP=100

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-r2-public-url

# Email (IMAP monitor + SMTP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_email_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Automation toggles
ENABLE_AUTOMATION=false
OUTREACH_ENABLED=false

# Test mode (routes all outbound messages to a single test target instead of real leads)
TEST_MODE=false
TEST_EMAIL=your_test_email@example.com
TEST_PHONE=your_test_phone_number
